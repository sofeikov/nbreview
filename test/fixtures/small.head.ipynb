   "source": [
    "# Losses\n",
    "\n",
    "We use a Poisson loss with a stable log.\n",
    "Weights are per task."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "loss-def",
   "metadata": {},
   "outputs": [],
   "source": [
    "#| export\n",
    "def loss(x, y, eps=1e-9):\n",
    "    return (x - y) ** 2 + eps"
   ]
  },
